#!/bin/bash

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Enable programmable completion features (Ubuntu ships
# `bash-completion` from the `bash-completion` package).

if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
fi

# Make Bash complete the `g` alias just like it does `git`,
# if `git` completion is available.

if complete -p git &> /dev/null; then
    __git_complete g git
fi
