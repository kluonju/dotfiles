#!/bin/bash

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Add commonly needed apt-managed locations (e.g. for things installed
# outside of `/usr/bin`, like `pipx`, `volta`, manual installs) to PATH.
# Most Ubuntu setup is handled by the install scripts that add entries
# to `~/.bash.local`.

export PATH="$HOME/.local/bin:$PATH"
